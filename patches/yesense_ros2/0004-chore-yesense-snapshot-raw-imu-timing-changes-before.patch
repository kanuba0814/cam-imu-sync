@@ -0,0 +1,25 @@
+# ImuRawHw.msg — Raw hardware-timed IMU message for cam_imu_sync
+#
+# Phase 1A: Does NOT rely on hardware timestamps (0x51/0x52).
+# Uses host-side steady_clock as the sole synchronisation anchor.
+# sample_timestamp / data_ready_timestamp / hw_ts_unit_sec are reserved
+# for future Phase 1B when hardware sync is available.
+
+std_msgs/Header header                       # frame_id; stamp = rx_ros_time (diagnostic)
+
+# ── Inertial data ──
+geometry_msgs/Vector3 linear_acceleration    # m/s² (converted from raw)
+geometry_msgs/Vector3 angular_velocity       # rad/s (converted from raw)
+geometry_msgs/Quaternion orientation         # AHRS attitude quaternion
+
+# ── Protocol sequence number (packet-loss / ordering check only) ──
+uint16 tid                                   # Protocol TID (1-60000, wraps)
+
+# ── Host-side time evidence (Phase 1A: sole sync basis) ──
+uint64 rx_steady_ns                          # steady_clock::now() at frame-decode confirm (ns)
+uint64 rx_ros_ns                             # ROS clock now() at frame-decode confirm (ns)
+
+# ── Hardware timestamp fields (reserved, Phase 1A: all zero) ──
+uint32 sample_timestamp                      # 0x51: reserved for future use
+uint32 data_ready_timestamp                  # 0x52: reserved for future use
+float64 hw_ts_unit_sec                       # reserved (0.0 in Phase 1A)
