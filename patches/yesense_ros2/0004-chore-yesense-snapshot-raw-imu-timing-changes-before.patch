+	std::deque<double> pipeline_periods_ms_;
+	std::chrono::steady_clock::time_point last_frame_steady_;
+	bool last_frame_steady_valid_ = false;
+
+	void update_pipeline_stats(std::chrono::steady_clock::time_point now) {
+		if (last_frame_steady_valid_) {
+			double period_ms = std::chrono::duration<double, std::milli>(
+				now - last_frame_steady_).count();
+			if (period_ms > 0 && period_ms < 100) {
+				pipeline_periods_ms_.push_back(period_ms);
+				while (pipeline_periods_ms_.size() > kPipelineStatsWindow_) {
+					pipeline_periods_ms_.pop_front();
+				}
+			}
+		}
+		last_frame_steady_ = now;
+		last_frame_steady_valid_ = true;
+	}
+
+	bool check_pipeline_ready() const {
+		if (pipeline_periods_ms_.size() < kPipelineStatsWindow_) return false;
+		double sum = std::accumulate(pipeline_periods_ms_.begin(),
+			pipeline_periods_ms_.end(), 0.0);
+		double mean = sum / pipeline_periods_ms_.size();
+		double sq_sum = 0.0;
+		for (auto p : pipeline_periods_ms_) sq_sum += (p - mean) * (p - mean);
+		double std_dev = std::sqrt(sq_sum / (pipeline_periods_ms_.size() - 1));
+		// Ready: mean ~5ms (200Hz), std < 1ms
+		return (mean >= 2.0 && mean <= 8.0 && std_dev < 1.0);
+	}
+
