+	void configure_realtime_thread(std::thread & thread, const char * name)
+	{
+		if (realtime_thread_priority_ <= 0 || !thread.joinable()) {
+			return;
+		}
+		sched_param sched{};
+		sched.sched_priority = realtime_thread_priority_;
+		const int rc = pthread_setschedparam(
+			thread.native_handle(), SCHED_FIFO, &sched);
+		if (rc != 0) {
+			RCLCPP_WARN(this->get_logger(),
+				"Failed to set %s SCHED_FIFO priority=%d: %s",
+				name, realtime_thread_priority_, std::strerror(rc));
+			return;
+		}
+		RCLCPP_INFO(this->get_logger(),
+			"Set %s SCHED_FIFO priority=%d",
+			name, realtime_thread_priority_);
+	}
