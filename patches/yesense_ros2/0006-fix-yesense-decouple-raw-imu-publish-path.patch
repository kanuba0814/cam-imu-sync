+	void enqueue_publish_frame(
+		const yis_out_data_t & data,
+		std::chrono::steady_clock::time_point host_steady_now)
+	{
+		{
+			std::lock_guard<std::mutex> lock(publish_queue_mutex_);
+			if (publish_queue_.size() >= publish_queue_depth_) {
+				publish_queue_.pop_front();
+				publish_queue_drop_count_++;
+			}
+			publish_queue_.push_back(QueuedImuFrame{data, host_steady_now});
+		}
+		publish_queue_cv_.notify_one();
+	}
+
+	void publish_loop()
+	{
+		while (running_.load() && rclcpp::ok()) {
+			QueuedImuFrame frame;
+			{
+				std::unique_lock<std::mutex> lock(publish_queue_mutex_);
+				publish_queue_cv_.wait(lock, [this]() {
+					return !running_.load() || !publish_queue_.empty();
+				});
+				if (!running_.load() && publish_queue_.empty()) {
+					break;
+				}
+				frame = publish_queue_.front();
+				publish_queue_.pop_front();
+			}
+
+			// §4.4 publish pipeline_ready once (方案 B)
