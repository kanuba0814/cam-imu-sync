 1 file changed, 2 insertions(+)

diff --git a/yesense_std_ros2/config/yesense_config.yaml b/yesense_std_ros2/config/yesense_config.yaml
index c7ba656..e03d777 100644
--- a/yesense_std_ros2/config/yesense_config.yaml
+++ b/yesense_std_ros2/config/yesense_config.yaml
@@ -6,3 +6,5 @@ yesense_pub:
         driver_type: "ros_serial"
         imu_topic_ros: "imu/data_raw"
         imu_topic: "imu_data"
